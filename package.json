{
  "name": "dsh-auto-continue",
  "version": "0.4.7",
  "description": "Auto-continue plugin for DeepSeek Harness (DSH): automatically resumes a turn that ended on a rate limit (429), an exhausted quota, an empty response, or your own configured error codes — with a per-session consecutive-failure limit, a one-click quick switch in the composer, and a Settings page.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "test/run.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "auto-continue",
    "auto-retry",
    "rate-limit",
    "429",
    "quota",
    "retry",
    "cordis"
  ],
  "author": "spix18 <spix18@users.noreply.github.com> (https://github.com/spix18)",
  "funding": "https://ko-fi.com/spix18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spix18/dsh-auto-continue.git"
  },
  "homepage": "https://github.com/spix18/dsh-auto-continue#readme",
  "bugs": {
    "url": "https://github.com/spix18/dsh-auto-continue/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/run.mjs"
  }
}
